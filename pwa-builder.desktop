[Desktop Entry]
Version=1.0
Type=Application
Name=PWA Manifest Studio
GenericName=Progressive Web App Manifest & ServiceWorker Workstation
Comment=Zero-Dependency PWA Manifest Studio, ServiceWorker Architect & Icon Forge
Exec=/usr/local/bin/pwa-builder desktop
Icon=pwa-manifest-builder
Terminal=false
Categories=Development;WebDevelopment;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open PWA Manifest CLI
Exec=x-terminal-emulator -e "/usr/local/bin/pwa-builder --help"

[Desktop Action Web]
Name=Open Web UI (Port 8100)
Exec=/usr/local/bin/pwa-builder web
